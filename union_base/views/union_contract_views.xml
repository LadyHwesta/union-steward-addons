<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="union_contract_view_list" model="ir.ui.view">
        <field name="name">union.contract.list</field>
        <field name="model">union.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="employer_id" />
                <field name="date_start" />
                <field name="date_end" />
            </list>
        </field>
    </record>

    <record id="union_contract_view_form" model="ir.ui.view">
        <field name="name">union.contract.form</field>
        <field name="model">union.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Memorial Hospital 2024-2028" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employer_id" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Bargaining Units" name="units">
                            <field name="unit_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="member_count" />
                                </list>
                            </field>
                        </page>
                        <page string="Shifts and Differentials" name="shifts">
                            <field name="shift_notes" placeholder="e.g. Evening 1500-2330: 9% differential" />
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="union_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">union.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first contract</p>
            <p>One per collective bargaining agreement: the employer, its
               bargaining units, and (with Grievances) its grievance procedure.</p>
        </field>
    </record>
</odoo>
