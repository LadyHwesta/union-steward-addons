<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="union_grievance_track_view_form" model="ir.ui.view">
        <field name="name">union.grievance.track.form</field>
        <field name="model">union.grievance.track</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Contract interpretation" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id" />
                            <field name="filed_by" widget="radio" />
                        </group>
                        <group>
                            <field name="article" />
                        </group>
                    </group>
                    <separator string="Steps, in order" />
                    <field name="step_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="deadline_days" />
                            <field name="day_kind" />
                            <field name="description" />
                        </list>
                    </field>
                    <separator string="Notes" />
                    <field name="notes" placeholder="e.g. what missing a deadline means under this contract" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="union_grievance_track_view_list" model="ir.ui.view">
        <field name="name">union.grievance.track.list</field>
        <field name="model">union.grievance.track</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="contract_id" />
                <field name="name" />
                <field name="filed_by" />
                <field name="article" />
            </list>
        </field>
    </record>

    <record id="union_grievance_track_action" model="ir.actions.act_window">
        <field name="name">Grievance Procedures</field>
        <field name="res_model">union.grievance.track</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up your contract's grievance procedure</p>
            <p>One per procedure in the contract (e.g. contract interpretation,
               discipline). List its steps in order with each one's deadline;
               grievances then fill in their deadlines from it.</p>
        </field>
    </record>

    <!-- Show a contract's procedures on the contract itself. -->
    <record id="union_contract_view_form_grievance" model="ir.ui.view">
        <field name="name">union.contract.form.grievance</field>
        <field name="model">union.contract</field>
        <field name="inherit_id" ref="union_base.union_contract_view_form" />
        <field name="arch" type="xml">
            <page name="units" position="after">
                <page string="Grievance Procedures" name="grievance_tracks">
                    <field name="grievance_track_ids">
                        <list>
                            <field name="name" />
                            <field name="filed_by" />
                            <field name="article" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
